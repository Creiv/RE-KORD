<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Music must keep playing with the screen off: this needs a foreground service
      of type mediaPlayback (since Android 14 the type must also be requested as a
      permission) and, since Android 13, the permission to show the notification.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Commands from the notification / headphones with the screen off: a wake lock of
      a few seconds keeps the CPU awake until the WebView has received the command.
      While the player plays (or is about to), RekordMediaService also holds a partial
      wake lock and a Wi-Fi lock, which need the same permission.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      Network changes (Wi-Fi to mobile data in the car): RekordMediaService tells the
      player to reconnect the stream. Without this permission the WebView does not
      watch the network either: no online/offline events, and connections of the
      network just lost are not dropped, so the stream waits on a dead socket.
      Normal permission, no prompt.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Camera for scanning the hub's QR code (barcode-scanner plugin). The plugin
      already declares it, but together with a *required* camera.any feature: on the
      Play Store a TV or tablet without a camera could not install the app.
      Here it is made optional (the address can always be typed by hand).
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false"
        tools:replace="android:required" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- TVs have no touchscreen: without this line the Play Store excludes them. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!--
      allowBackup=false: Android's automatic backup would copy the WebView's
      localStorage (hub address, chosen account) to another phone, where that hub
      may not exist. The real data lives on the hub and has its own backup.
      banner: Android TV launcher icon (LEANBACK_LAUNCHER requires it).
    -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.rekord_client"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!--
          Google Cast (RekordCast.kt): Play Services reads from here the class with
          the options (Default Media Receiver, Cast SDK notification disabled).
        -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="app.rekord.client.RekordCastOptionsProvider" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Media notification and controls: the MEDIA_BUTTON filter serves both the
          headphone button and the notification buttons, which go through MediaButtonReceiver.
          MediaBrowserService: Android Auto, car head units that browse (AVRCP) and the
          system's media controls find the app, connect to its session and can resume
          the last track. Exported for that reason (they bind from other packages).
        -->
        <service
            android:name=".RekordMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Android Auto lists media apps that declare this. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
