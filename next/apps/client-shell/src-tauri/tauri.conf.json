{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RE-KORD",
  "version": "5.1.0",
  "identifier": "app.rekord.client",
  "build": {
    "beforeDevCommand": "pnpm --filter @rekord/client-ui dev",
    "devUrl": "http://localhost:7422",
    "beforeBuildCommand": "pnpm --filter @rekord/client-ui build",
    "frontendDist": "../../client-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "RE-KORD",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "wix": null
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {}
}
